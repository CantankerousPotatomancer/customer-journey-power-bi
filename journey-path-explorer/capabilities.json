{
    "$schema": "https://developer.microsoft.com/json-schemas/core-build/capabilities.json",
    "dataRoles": [
        {
            "displayName": "From Step",
            "name": "fromStep",
            "kind": "Grouping",
            "description": "Integer step number (1, 2, 3…) — the step at which this transition originates"
        },
        {
            "displayName": "From Node",
            "name": "fromNode",
            "kind": "Grouping",
            "description": "Label of the node the customer came FROM"
        },
        {
            "displayName": "To Node",
            "name": "toNode",
            "kind": "Grouping",
            "description": "Label of the node the customer went TO"
        },
        {
            "displayName": "Transition Count",
            "name": "transitionCount",
            "kind": "Measure",
            "description": "Numeric count of transitions for this FromNode → ToNode pair at this step"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "fromStep": { "max": 1 },
                    "fromNode": { "max": 1 },
                    "toNode": { "max": 1 },
                    "transitionCount": { "max": 1 }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "fromStep" } },
                        { "for": { "in": "fromNode" } },
                        { "for": { "in": "toNode" } },
                        { "for": { "in": "transitionCount" } }
                    ],
                    "dataReductionAlgorithm": {
                        "window": { "count": 30000 }
                    }
                }
            }
        }
    ],
    "objects": {
        "dataControls": {
            "properties": {
                "topN": {
                    "type": { "numeric": true }
                },
                "minCount": {
                    "type": { "numeric": true }
                }
            }
        },
        "appearance": {
            "properties": {
                "barOpacity": {
                    "type": { "numeric": true }
                },
                "showRank": {
                    "type": { "bool": true }
                },
                "showCount": {
                    "type": { "bool": true }
                },
                "columnMinWidth": {
                    "type": { "numeric": true }
                },
                "fontSize": {
                    "type": { "numeric": true }
                }
            }
        },
        "colorRule1": {
