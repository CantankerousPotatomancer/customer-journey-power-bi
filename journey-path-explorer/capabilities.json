{
    "$schema": "https://developer.microsoft.com/json-schemas/core-build/capabilities.json",
    "dataRoles": [
        {
            "displayName": "From Step",
            "name": "fromStep",
            "kind": "Grouping",
            "description": "Integer step number (1, 2, 3…) — the step at which this transition originates"
        },
        {
            "displayName": "From Node",
            "name": "fromNode",
            "kind": "Grouping",
            "description": "Label of the node the customer came FROM"
        },
        {
            "displayName": "To Node",
            "name": "toNode",
            "kind": "Grouping",
            "description": "Label of the node the customer went TO"
        },
        {
            "displayName": "Transition Count",
            "name": "transitionCount",
            "kind": "Measure",
            "description": "Numeric count of transitions for this FromNode → ToNode pair at this step"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "fromStep": { "max": 1 },
                    "fromNode": { "max": 1 },
                    "toNode": { "max": 1 },
                    "transitionCount": { "max": 1 }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "fromStep" } },
                        { "for": { "in": "fromNode" } },
                        { "for": { "in": "toNode" } },
                        { "for": { "in": "transitionCount" } }
                    ],
                    "dataReductionAlgorithm": {
                        "window": { "count": 30000 }
                    }
                }
            }
        }
    ],
    "objects": {
        "dataControls": {
            "displayName": "Data Controls",
            "properties": {
                "topN": {
                    "displayName": "Top N per step",
                    "description": "Maximum number of nodes shown per step column",
                    "type": { "numeric": true }
                },
                "minCount": {
                    "displayName": "Min transition count",
                    "description": "Nodes with fewer transitions than this threshold are hidden",
                    "type": { "numeric": true }
                }
            }
        },
        "appearance": {
            "displayName": "Appearance",
            "properties": {
                "barOpacity": {
                    "displayName": "Bar fill opacity (%)",
                    "description": "Opacity of the bar fill color (0–100)",
                    "type": { "numeric": true }
                },
                "showRank": {
                    "displayName": "Show rank numbers",
                    "description": "Show 1, 2, 3… rank prefix on each node row",
                    "type": { "bool": true }
                },
                "showCount": {
                    "displayName": "Show transition count",
                    "description": "Show the numeric transition count on the right side of each row",
                    "type": { "bool": true }
                },
                "columnMinWidth": {
                    "displayName": "Column min width (px)",
                    "description": "Minimum pixel width for each step column",
                    "type": { "numeric": true }
                },
                "fontSize": {
                    "displayName": "Font size",
                    "description": "Base font size in pixels for node labels",
                    "type": { "numeric": true }
                }
            }
        },
        "colorRule1": {
            "displayName": "Color Rule 1",
            "properties": {
                "substring": { "displayName": "Substring", "type": { "text": true } },
                "color": { "displayName": "Color", "type": { "fill": { "solid": { "color": true } } } }
